---
import Demo from '../components/Demo.tsx'
import SiteFooter from '../components/SiteFooter.astro'
import SiteHeader from '../components/SiteHeader.astro'
import Page from '../layouts/Page.astro'
---

<Page
  title="Sift - YouTube, without the noise."
  description="A calm, text-first YouTube. Join the first 1,000 early users and get three months of Sift Pro free. No card required."
  canonical="https://sifttheweb.com/"
  root="./"
>
  <SiteHeader root="./">
    <nav class="header-nav" aria-label="Main"><a class="header-link" href="#roadmap">Roadmap</a><a class="header-link" href="#early-access">Early access</a></nav>
  </SiteHeader>
  <main id="main" class="wrap" tabindex="-1">
    <section class="hero" aria-labelledby="hero-title">
      <h1 id="hero-title">Find something good.<br />Leave the noise behind.</h1>
      <p class="lede">
        A calm, text-first YouTube.
      </p>
      <div class="install-actions">
        <a class="install-cta" href="https://chromewebstore.google.com/detail/edhndblebjdnecafmjcbmcdfemmojala">
          <span>Add to Chrome</span>
          <span aria-hidden="true">↗</span>
        </a>
        <a class="preview-link" href="./beta/">Try Sift Preview, with new features first</a>
      </div>
      <p class="install-note">Three months of Sift Pro, free. First 1,000 activations.</p>
    </section>
    <figure class="app-demo">
      <Demo client:visible />
      <figcaption class="demo-caption">Sample summaries. Sift writes these for any YouTube video, from its captions.</figcaption>
    </figure>
    <section class="features" aria-label="A more intentional way to watch">
      <article class="feature">
        <div class="feature-art"><img src="./assets/illustrations/shredder.webp" width="1536" height="1024" alt="" decoding="async" /></div>
        <div class="feature-copy">
        <h2>Sift out the noise.</h2>
        <p>The gist, without watching every minute.</p>
        </div>
      </article>
      <article class="feature">
        <div class="feature-art"><img src="./assets/illustrations/edition.webp" width="1536" height="1024" alt="" decoding="async" /></div>
        <div class="feature-copy">
        <h2>Your attention. Your choice.</h2>
        <p>Choose what deserves a watch.</p>
        </div>
      </article>
      <article class="feature">
        <div class="feature-art"><img src="./assets/illustrations/conversation.webp" width="1536" height="1024" alt="" decoding="async" /></div>
        <div class="feature-copy">
        <h2>Go beyond watching.</h2>
        <p>Ask questions. Go deeper.</p>
        </div>
      </article>
    </section>
    <section class="roadmap" id="roadmap" aria-labelledby="roadmap-title">
      <div class="roadmap-intro">
        <h2 id="roadmap-title">What’s next.</h2>
      </div>
      <ol class="roadmap-list">
        <li class="roadmap-now">
          <div class="roadmap-number" aria-hidden="true"></div>
          <div class="roadmap-content">
            <div class="roadmap-heading"><h3>YouTube</h3><span class="roadmap-status">Now</span></div>
            <p>Get the gist. Skip the rabbit hole.</p>
          </div>
        </li>
        <li>
          <div class="roadmap-number" aria-hidden="true"></div>
          <div class="roadmap-content">
            <div class="roadmap-heading"><h3>Safari</h3><span class="roadmap-status">Up next</span></div>
            <p>A calmer web on iPhone, iPad, and Mac.</p>
          </div>
        </li>
        <li>
          <div class="roadmap-number" aria-hidden="true"></div>
          <div class="roadmap-content">
            <div class="roadmap-heading"><h3>Instagram</h3><span class="roadmap-status">Planned</span></div>
            <p>Find inspiration. Lose the endless scroll.</p>
          </div>
        </li>
        <li>
          <div class="roadmap-number" aria-hidden="true"></div>
          <div class="roadmap-content">
            <div class="roadmap-heading"><h3>Facebook</h3><span class="roadmap-status">Planned</span></div>
            <p>Keep the connections. Leave the noise.</p>
          </div>
        </li>
      </ol>
    </section>
    <section class="early-access" id="early-access" aria-labelledby="early-access-title">
      <div class="early-access-copy">
        <h2 id="early-access-title">Help shape<br />a calmer internet.</h2>
        <p>Three months of Pro, free for the first 1,000.</p>
        <div class="install-actions"><a class="install-cta" href="https://chromewebstore.google.com/detail/edhndblebjdnecafmjcbmcdfemmojala"><span>Add to Chrome</span><span aria-hidden="true">↗</span></a><a class="preview-link" href="./beta/">Or try Sift Preview</a></div>
        <p class="install-note">No card required.</p>
      </div>
      <div class="early-access-faq">
        <details><summary>How do I start?</summary><p>Add Sift from the Chrome Web Store, then activate Pro with Google in Settings. Your six months start at activation. First 1,000 people; one offer per person.</p></details>
        <details><summary>What does Pro include?</summary><p>400 summaries and chat answers combined each calendar month, shared across your devices. Plus new Pro features during your offer.</p></details>
        <details><summary>What happens after three months?</summary><p>Stay free or choose a paid plan. Pricing will be shared at least 30 days before your offer ends. No automatic charges.</p></details>
        <details><summary>What is Sift Preview?</summary><p>The same extension, updated first. New features arrive days or weeks before the Chrome Web Store version. You install it by hand.</p></details>
        <details><summary>Can I use Sift on my phone?</summary><p>Desktop Chrome for now. Safari on iPhone, iPad, and Mac is next, for websites only.</p></details>
      </div>
    </section>
  </main>
  <SiteFooter root="./" />
</Page>
